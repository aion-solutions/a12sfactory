{
    "name": "aion-solutions/a12sfactory",
    "description": "A Website factory built by Aïon Solutions",
    "type": "drupal-profile",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Aïon Solutions",
            "homepage": "https://www.aion-solutions.lu",
            "role": "Maintainer"
        }
    ],
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "assets": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    },
    "require": {
        "cweagans/composer-patches": "^1.7",
        "drupal/a12s": "2.0.x@dev",
        "drupal/core": "^11.3.3",
        "drupal/core-composer-scaffold": "^11.3.3",
        "drupal/token": "^1.17",
        "drush/drush": "^13.7",
        "php": ">=8.3"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "patches": {
            "drupal/core": {
                "Issue #2893892: Fixed Warning Invalid argument supplied for foreach() in Drupal": "https://www.drupal.org/files/issues/2022-06-28/2893892-27.patch",
                "Issue #2888320: Add support for Token and plural in Views Global result summary plugin": "https://git.drupalcode.org/project/drupal/-/merge_requests/12147.diff",
                "Issue #1819538: More link disappears when time-based views cache is enabled": "https://www.drupal.org/files/issues/2021-03-10/1819538-65.patch",
                "Issue #2789125: Error when a process plugin gives a multiple value for a subproperty destination": "https://www.drupal.org/files/issues/2789125-19.patch",
                "Issue #2986041: Triggering RefreshView on a view is making multiple ajax calls": "https://www.drupal.org/files/issues/2023-10-11/2986041-29.patch",
                "Issue #2689459: If you don't want to translate your URL alias, the original URL alias won't work with your translations": "./patches/core-untranslable-url-alias-2689459.patch.txt",
                "Issue #2546212: Entity view/form mode formatter/widget settings have no translation UI": "https://git.drupalcode.org/project/drupal/-/merge_requests/4294.diff",
                "Issue #3051453: Call to a member function setSyncing() on null when installing a module": "https://www.drupal.org/files/issues/2020-08-18/protect_against_invalid_ids_in_import_delete-3051453-10.patch",
                "Issue #2643466: Use TrustedRedirectResponse Error on Multilingual Setup": "https://www.drupal.org/files/issues/2019-12-03/2643466-31.patch",
                "Issue #3328425: Unable to link text in rich text field using CKEditor 5 when adding a new Media entity via a Media field on a node.": "https://git.drupalcode.org/project/drupal/-/merge_requests/8896.diff",
                "Issue #2730351: CSRF check always fails for users without a session": "patches/core-CSRF-check-always-fails-for-users-without-session-2730351-11.4.1.diff"
            },
            "drupal/token": {
                "Issue #3115486: Provide array of primitive property values on multivalue field": "https://git.drupalcode.org/project/token/-/merge_requests/114/diffs.diff"
            }
        }
    }
}
